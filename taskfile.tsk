buildall {
    cargo build --release
}

install {
    @default
    if $$OS == linux {
        sudo cp target/release/buf /usr/bin
    } else if $$OS == windows {
        @error("Please add the path in target\release\ to the PATH")
    } else {
        sudo cp target/release/buf /usr/local/bin/buf
    }
}


gui {
    cargo build --release -p buf-gui
}

cli {
    cargo build --release -p buf-cli 
}